@rendermode InteractiveServer
@implements VideoComponent
@implements IDisposable

@using System.Text.Json
@using WatchTogether3.Data

@inject IJSRuntime JS
@inject ApplicationDbContext DbContext

<video width="320" height="240" id="video_comp">
        Your browser does not support the video tag.
</video>
<button id="play_btn" style="visibility: visible">Play</button>

@code {
    [Parameter]
    public VideoFile? Video { get; set; }

    [Parameter]
    public bool DoShowControls { get; set; } = true;

    private IJSObjectReference JsModule;
    private string prevUrl;

    public event VideoActionHandler OnVideoProceed;
    public event VideoActionHandler OnVideoPause;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            JsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/VideoComponent/VideoComponentFile.razor.js");

            var lDotNetReference = DotNetObjectReference.Create(this);
            await JsModule.InvokeVoidAsync("setDotnetReference", lDotNetReference);
        }

        if (Video is not null && JsModule is not null && prevUrl != Video.Url)
        {
            await JsModule.InvokeVoidAsync("LoadVideo", Video.Url, Video.CurrentTime);
            prevUrl = Video.Url;

            await InvokeAsync(StateHasChanged);
        }

        await base.OnAfterRenderAsync(firstRender);
    }


    public void Proceed()
    {
        JsModule.InvokeVoidAsync("ProceedVideo");
    }

    public void Pause()
    {
        JsModule.InvokeVoidAsync("PauseVideo");
    }

    public void Seek(double time)
    {
        JsModule.InvokeVoidAsync("SeekVideo", time);
    }

    public void ClearSource()
    {
        JsModule.InvokeVoidAsync("ClearVideo");
    }

    /// <summary>
    /// Do not use this method to initialize the video. This method is called from JavaScript when the video metadata is loaded. <br/>
    /// </summary>
    [JSInvokable]
    public void InitVideo()
    {
        if (Video is null)
            return;

        DbContext.Videos.Entry(Video).Reload();

        JsModule.InvokeVoidAsync("initVideo", Video?.CurrentTime, Video?.IsPlaying, DoShowControls);
    }


    /// <summary>
    /// This method is called from JavaScript when a user interacts with the video element (play, pause, seek). <br/>
    /// Please do not call this method from C#.
    /// </summary>
    /// <param name="actions"></param>
    /// <param name="args"></param>
    [JSInvokable]
    public void ReceiveAction(UserActions2 actions, params JsonElement[] args)
    {
        switch (actions)
        {
            case UserActions2.ProceedVideo:
                {
                    double time = args[0].GetDouble();
                    OnVideoProceed?.Invoke(this, time);
                    break;
                }
            case UserActions2.PauseVideo:
                {
                    double time = args[0].GetDouble();
					OnVideoPause?.Invoke(this, time);
                    break;
                }
        }
    }

	public void Dispose()
	{
		ClearSource();
		JsModule?.DisposeAsync();
	}
}
