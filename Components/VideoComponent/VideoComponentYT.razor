@using System.Text.Json
@using WatchTogether3.Data
@inject IJSRuntime JS
@implements VideoComponent

<div id="player_container">
    <div id="player_div"></div>
</div>

<script id="me">
    var UserActions = Object.freeze({
        ProceedVideo: 0,
        PauseVideo: 1
    });

	var DoSendAction = true;

    var dnh = null;
    function setDotnetReference(dotnetRef) {
        console.log("received DNR");
        dnh = dotnetRef;
    }

    initAPI();

    function initAPI() {
        var tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        var firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
    }

    var player;
    function onYouTubeIframeAPIReady() {
        player = new YT.Player('player_div', {
            height: '390',
            width: '640',
            playerVars: {
                'playsinline': 1,
                'color': 'white'
            },
            events: {
                'onReady': onPlayerReady,
                'onStateChange': onPlayerStateChange,
            }
        });
    }

    function onPlayerReady(event) {
        dnh.invokeMethodAsync("LoadYtTag");
    }

	var prevEvent = null;
    var prevEventPlayerTime = null;
    function onPlayerStateChange(event) {
        if (prevEvent == YT.PlayerState.BUFFERING && event.data == YT.PlayerState.PLAYING) {
            SendAction(UserActions.ProceedVideo, prevEventPlayerTime);
        } 
        else if (event.data == YT.PlayerState.PAUSED) {
            SendAction(UserActions.PauseVideo, player.getCurrentTime());
        }
        else if (event.data == YT.PlayerState.UNSTARTED) {
            dnh.invokeMethodAsync("InitVideo");
        }

        prevEventPlayerTime = player.getCurrentTime();
		prevEvent = event.data;
    }


    function ClearVideo() {
        player.stopVideo();
        player.clearVideo();
	}

    function ProceedVideo() {
        if (player.getPlayerState() != 1) {            
            DoSendAction = false;
            player.playVideo();
        }
	}
    function PauseVideo() {
        if (player.getPlayerState() != 2) {
            DoSendAction = false;
            player.pauseVideo();
        }        
    }
    function SeekVideo(time) {
		// If the video is paused do not set DoSendAction to false,
		// because that would cause next event to be ignored.
        if (player.getPlayerState() != 2) {
            DoSendAction = false;
        }
        player.seekTo(time, true);
    }
    function LoadVideo(tag) {
        player.cueVideoById(tag);
    }


    function SendAction(action, ...args) {
        if (dnh == null || DoSendAction == false) {
            DoSendAction = true;
            return;
        }

		console.log("Sending action: " + action + " with args: " + args);
        dnh.invokeMethodAsync('ReceiveAction', action, args);
    }
</script>

@code {
    [Parameter]
    public VideoFile? Video { get; set; }

    [Parameter]
    public bool DoShowControls { get; set; } = true;


    public event VideoActionHandler OnVideoProceed;
    public event VideoActionHandler OnVideoPause;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            JS.InvokeVoidAsync("setDotnetReference", DotNetObjectReference.Create(this));
        }

        base.OnAfterRender(firstRender);
    }

    public void Proceed()
    {
        JS.InvokeVoidAsync("ProceedVideo");
    }

    public void Pause()
    {
        JS.InvokeVoidAsync("PauseVideo");
    }

    public void Seek(double time)
    {
        JS.InvokeVoidAsync("SeekVideo", time);
    }

    public void ClearSource()
    {
        JS.InvokeVoidAsync("ClearVideo");
    }

    public void InitComponent()
    {
        //JS.InvokeVoidAsync("initAPI");
        JS.InvokeVoidAsync("onYouTubeIframeAPIReady");
    }

    [JSInvokable]
    public void LoadYtTag()
    {
        if (Video is null)
            return;

        JS.InvokeVoidAsync("LoadVideo", Video.YouTubeTag);
    }

    [JSInvokable]
    public void InitVideo()
    {
        if (Video is null)
            return;

        Seek(Video.CurrentTime);

        if (Video.IsPlaying)
            Proceed();
    }


    /// <summary>
    /// This method is called from JavaScript when a user interacts with the video element (play, pause, seek). <br/>
    /// Please do not call this method from C#.
    /// </summary>
    /// <param name="actions"></param>
    /// <param name="args"></param>
    [JSInvokable]
    public void ReceiveAction(UserActions2 actions, params JsonElement[] args)
    {
        switch (actions)
        {
            case UserActions2.ProceedVideo:
                {
					double time = args[0].GetDouble();
                    OnVideoProceed?.Invoke(this, time);
                    break;
                }
            case UserActions2.PauseVideo:
                {
                    double time = args[0].GetDouble();
                    OnVideoPause?.Invoke(this, time);
                    break;
                }
        }
    }
}
