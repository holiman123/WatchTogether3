@using System.Text.Json
@using WatchTogether3.Data
@inject IJSRuntime JS
@implements VideoComponent
@implements IDisposable

@* <script src="Components/VideoComponent/VideoComponentYT.razor.js" type="text/javascript"></script> *@
<div id="youtube_api_sctipt_div"></div>

<div id="player_container">
    <div id="player_div"></div>
</div>

<script>
    function onYouTubeIframeAPIReady() {
        console.log('YouTube API is ready from razor page');
    }
</script>

@code {
    [Parameter]
    public VideoFile? Video { get; set; }

    [Parameter]
    public bool DoShowControls { get; set; } = true;

    private IJSObjectReference jsModule;

    public event VideoActionHandler OnVideoProceed;
    public event VideoActionHandler OnVideoPause;

    protected override async Task OnInitializedAsync()
    {


        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/VideoComponent/VideoComponentYT.razor.js");

            await JS.InvokeVoidAsync("initAPI");

            await jsModule.InvokeVoidAsync("setDotnetReference", DotNetObjectReference.Create(this));

            await InvokeAsync(StateHasChanged);

            await jsModule.InvokeVoidAsync("onYouTubeIframeAPIReady");

            // await JS.InvokeVoidAsync("setDotnetReference", DotNetObjectReference.Create(this));
            // _ = 0;
        }

        base.OnAfterRender(firstRender);
    }

    public void Proceed()
    {
        jsModule.InvokeVoidAsync("ProceedVideo");
    }

    public void Pause()
    {
        jsModule.InvokeVoidAsync("PauseVideo");
    }

    public void Seek(double time)
    {
        jsModule.InvokeVoidAsync("SeekVideo", time);
    }

    public void ClearSource()
    {
        jsModule.InvokeVoidAsync("ClearVideo");
    }

    public async void InitComponent()
    {
        //await JS.InvokeVoidAsync("setDotnetReference", DotNetObjectReference.Create(this));

        //await JS.InvokeVoidAsync("onYouTubeIframeAPIReady");
    }

    [JSInvokable]
    public void LoadYtTag()
    {
        if (Video is null)
            return;

        // Send youtube tag
        jsModule.InvokeVoidAsync("LoadVideo", Video.YouTubeTag, Video.CurrentTime);
    }

    [JSInvokable]
    public void InitVideo()
    {
        if (Video is null)
            return;

        Seek(Video.CurrentTime);

        if (!Video.IsPlaying)
            Pause();
    }


    /// <summary>
    /// This method is called from JavaScript when a user interacts with the video element (play, pause, seek). <br/>
    /// Please do not call this method from C#.
    /// </summary>
    /// <param name="actions"></param>
    /// <param name="args"></param>
    [JSInvokable]
    public void ReceiveAction(UserActions2 actions, params JsonElement[] args)
    {
        switch (actions)
        {
            case UserActions2.ProceedVideo:
                {
                    double time = args[0].GetDouble();
                    OnVideoProceed?.Invoke(this, time);
                    break;
                }
            case UserActions2.PauseVideo:
                {
                    double time = args[0].GetDouble();
                    OnVideoPause?.Invoke(this, time);
                    break;
                }
        }
    }

    public void Dispose()
    {
        _ = 0;
    }
}
