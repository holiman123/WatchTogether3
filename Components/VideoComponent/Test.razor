@page "/test"
@using WatchTogether3.Data
@rendermode InteractiveServer

<br/>
<div>
	<VideoComponentYT
		@ref="videoComponent" 
		Video="@video"/>

	<br/>
	<button @onclick="PlayButton">Play Video</button>
	<br />
	<button @onclick="PauseButton">Pause Video</button>
	<br />
	<button @onclick="SeekButton">Seek Video</button>
	<br />
	<button @onclick="Clear">Clear Video</button>
	<br />
	<button @onclick="ChangeUrl">Change Video</button>
	<p>Current URL: @video?.Url</p>
	<br/>
	<InputCheckbox @bind-Value="isPlayingWhenLoading">Is playing by default</InputCheckbox>

	<br />
	<p>@lastAction</p>
</div>

@code {
	private VideoComponent videoComponent { get; set; }
	private string lastAction { get; set; }
	private string url { get; set; } = "api/Videos/get/masha.mp4";
	private bool isPlayingWhenLoading { get; set; } = false;
	private VideoFile video { get; set; }

	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			video = new VideoFile
			{
				FileName = "masha.mp4",
				Url = "api/Videos/get/masha.mp4",
				SourceType = VideoSourceType.Local,
				YouTubeTag = "Ty03SgAgsfg",
				CurrentTime = 1,
				LastPlayTime = DateTime.Now,
				IsPlaying = true,
				FriendlyName = "Masha"
			};

			videoComponent.Video = video;

			videoComponent.OnVideoProceed += (_, time) => 
			{ 
				lastAction = $"Video proceeded at {time} seconds"; 
				InvokeAsync(StateHasChanged); 
			};
			videoComponent.OnVideoPause += (_, time) => 
			{ 
				lastAction = $"Video paused at {time} seconds"; 
				InvokeAsync(StateHasChanged); 
			};

			videoComponent.InitComponent();

			InvokeAsync(StateHasChanged);
		}
	}

	private void PlayButton()
	{
		videoComponent.Proceed();
	}

	private void PauseButton()
	{
		videoComponent.Pause();
	}

	private void SeekButton()
	{
		videoComponent.Seek(2);
	}

	private void Clear()
	{
		videoComponent.ClearSource();
	}

	private void ChangeUrl()
	{
		if (video.Url == "api/Videos/get/masha.mp4")
			video.Url = "api/Videos/get/masha2.mp4";
		else
			video.Url = "api/Videos/get/masha.mp4";
	}
}