@page "/test"
@rendermode InteractiveServer

<br/>
<div>
	<VideoComponent 
		@ref="videoComponent" />

	<br/>
	<button @onclick="PlayButton">Play Video</button>
	<br />
	<button @onclick="PauseButton">Pause Video</button>
	<br />
	<button @onclick="SeekButton">Seek Video</button>
	<br />
	<button @onclick="Clear">Clear Video</button>
	<br />
	<button @onclick="ChangeUrl">Change Video</button>
	<p>Current URL: @url</p>
	<br/>
	<InputCheckbox @bind-Value="isPlayingWhenLoading">Is playing by default</InputCheckbox>

	<br />
	<p>@lastAction</p>
</div>

@code {
	private VideoComponent videoComponent { get; set; }
	private string lastAction { get; set; }
	private string url { get; set; } = "api/Videos/get/masha.mp4";
	private TestClass testClass { get; set; } = null;
	private bool isPlayingWhenLoading { get; set; } = false;

	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			videoComponent.OnVideoProceed += (_) => 
			{ 
				lastAction = $"Video proceeded"; 
				InvokeAsync(StateHasChanged); 
			};
			videoComponent.OnVideoPause += (time) => 
			{ 
				lastAction = $"Video paused at {time} seconds"; 
				InvokeAsync(StateHasChanged); 
			};
			videoComponent.OnVideoSeek += (time) => 
			{ 
				lastAction = $"Video seeked to {time} seconds"; 
				InvokeAsync(StateHasChanged); 
			};

			testClass = new TestClass(isPlayingWhenLoading, true, 3);

			videoComponent.InitComponent();
		}
	}

	private void PlayButton()
	{
		videoComponent.Proceed();
	}

	private void PauseButton()
	{
		videoComponent.Pause(1);
	}

	private void SeekButton()
	{
		videoComponent.Seek(2);
	}

	private void Clear()
	{
		videoComponent.ClearSource();
	}

	private void ChangeUrl()
	{
		if (url == "api/Videos/get/masha.mp4")
			url = "api/Videos/get/masha2.mp4";
		else
			url = "api/Videos/get/masha.mp4";
	}

	class TestClass
	{
		public bool IsPlayingWhenLoading { get; set; }
		public bool DoShowControls { get; set; }
		public double StartTime { get; set; }

		public TestClass(bool isPlayingWhenLoading, bool doShowControls, double startTime)
		{
			IsPlayingWhenLoading = isPlayingWhenLoading;
			DoShowControls = doShowControls;
			StartTime = startTime;
		}
	}
}