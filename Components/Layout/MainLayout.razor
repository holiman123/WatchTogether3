@using System.Security.Claims
@inherits LayoutComponentBase

@inject AuthenticationStateProvider auth

<div>
    <div class="nav-bar">
        <div >
            <NavLink href="/">Home</NavLink>
        </div>

        <div class="mark">
            Created by 
            <a href="https://www.linkedin.com/in/daniil-luchytskyi-7ba6b9391?utm_source=share_via&utm_content=profile&utm_medium=member_android">
                Daniil Luchytskyi</a>
            with lo... love?
        </div>

        <div class="flex-item">
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/Account/Friends">Friends</NavLink>

                    Hi @User.Identity.Name 0ᴗ0ﾉﾞ
                </Authorized>
            </AuthorizeView>

            <NavLink href="/Account/Manage">Account</NavLink>
        </div>
    </div>

    @Body

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
</div>

@code
{
    private ClaimsPrincipal User;

    protected override async void OnInitialized()
    {
        var state = await auth.GetAuthenticationStateAsync();
        User = state.User;
    }
}