@page "/"
@rendermode InteractiveServer

@using System.Threading.Tasks
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WatchTogether3.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider auth
@inject UserManager<ApplicationUser> userManager
@inject SignInManager<ApplicationUser> signInManager
@inject ProtectedSessionStorage sessionStorage
@inject RoomsGuestsService RoomsGuests

<PageTitle>Home</PageTitle>

<div class="top">
    <div class="search-bar-div">
        <InputText class="search-bar" @bind-Value="roomSearch" @oninput="(e) => { roomSearch = e.Value.ToString(); SearchRooms(); }" />
        <AuthorizeView>
            <Authorized>
                <InputCheckbox @bind-Value="FriendsOnly" />Friends rooms
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="bottom">
    <div class="rooms">
        <AuthorizeView>
            <Authorized>
                <div class="rooms-block">
                    <div class="block-top">
                        <p>My rooms</p>
                        <NavLink class="button" href="/CreateRoom">Create</NavLink>
                    </div>
                    <div class="rooms-list">
                        @foreach (Data.Room room in MyRooms)
                        {
                            <div class="room" @onclick="() => GoToRoom(room)">
                                @if (room.CurrentVideo is null)
                                {
                                    <div class="no-image-blur"></div>
                                    <div class="no-image">
                                        STILL DECIDING
                                    </div>
                                }
                                else
                                {
                                    @if (room.CurrentVideo.SourceType == VideoSourceType.Local)
                                    {
                                        <img class="image-blur" src="@($"api/Videos/getframe/{room.Id}_{room.CurrentVideo.FileName}-{room.CurrentVideo.CurrentTime}")">
                                        <div class="image-window">
                                            <img class="image" src="@($"api/Videos/getframe/{room.Id}_{room.CurrentVideo.FileName}-{room.CurrentVideo.CurrentTime}")">
                                        </div>
                                    }
                                    else
                                    {
                                        <img class="image-blur" src="@($"https://img.youtube.com/vi/{room.CurrentVideo.YouTubeId}/hqdefault.jpg")">
                                        <div class="image-window">
                                            <img class="image" src="@($"https://img.youtube.com/vi/{room.CurrentVideo.YouTubeId}/hqdefault.jpg")">
                                        </div>
                                    }
                                    <div class="img-shadow" />
                                }
                                <p class="room-name">@room.Name</p>
                                <div class="room-footer">
                                    <p class="room-auth">by @room.Owner.UserName</p>
                                    <p class="room-viewers">@(RoomsGuests.GetGuests(room.Id).Count())</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="rooms-block">
            <div class="block-top">
                <p>Public rooms</p>
            </div>
            <div class="rooms-list">
                @foreach (Data.Room room in roomSearchResults)
                {
                    if (!FriendsOnly || (User is not null && User.Friendships
                                                .Where(f => f.Status == FriendshipStatus.Accepted)
                                                .Select(f => f.Friend)
                                                .Contains(room.Owner)))
                    {
                        <div class="room" @onclick="() => GoToRoom(room)">
                            @if (room.CurrentVideo is null)
                            {
                                <div class="no-image-blur"></div>
                                <div class="no-image">
                                    STILL DECIDING
                                </div>
                            }
                            else
                            {
                                @if (room.CurrentVideo.SourceType == VideoSourceType.Local)
                                {
                                    <img class="image-blur" src="@($"api/Videos/getframe/{room.Id}_{room.CurrentVideo.FileName}-{room.CurrentVideo.CurrentTime}")">
                                    <div class="image-window">
                                        <img class="image" src="@($"api/Videos/getframe/{room.Id}_{room.CurrentVideo.FileName}-{room.CurrentVideo.CurrentTime}")">
                                    </div>
					            }
					            else
					            {
                                    <img class="image-blur" src="@($"https://img.youtube.com/vi/{room.CurrentVideo.YouTubeId}/hqdefault.jpg")">
                                    <div class="image-window">
                                        <img class="image" src="@($"https://img.youtube.com/vi/{room.CurrentVideo.YouTubeId}/hqdefault.jpg")">
                                    </div>
                                }
                                <div class="img-shadow"/>
                            }
                            <p class="room-name">@room.Name</p>
                            <div class="room-footer">
                                <p class="room-auth">by @room.Owner.UserName</p>
                                <p class="room-viewers">@(room.Participants.Count())</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <AuthorizeView>
        <Authorized>
            <div class="friends">
                <div class="block-top">
                    <p>Friends</p>
                </div>
                <div class="friends-list">
                    @foreach(Friendship friendship in User?.Friendships)
                    {
                        <div class="friend-block">
                            <p>@friendship.Friend?.UserName</p>
                            <div class="multi-button">
                                @if (friendship.Friend?.CurrentRoom is not null)
                                {
                                    <p @onclick="() => GoToRoom(friendship.Friend?.CurrentRoom)" class="first button-part">connect</p>
                                }
                                else
                                {
                                    <p class="first button-part-unactive">connect</p>
                                }
                                <div class="separator"></div>
                                <p class="second button-part">rooms</p>
                            </div>
                        </div>
                    }
                </div>
                <a href="Account/Friends">Add</a>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

<script>
    
</script>

@code {

    private string roomSearch { get; set; } = string.Empty;

    private ICollection<Data.Room> roomSearchResults { get; set; }
    private ICollection<Data.Room> MyRooms { get; set; }

    private Dictionary<int, string> PasswordInputs { get; set; } = new Dictionary<int, string>();

    private bool FriendsOnly { get; set; } = false;

    private ApplicationUser User { get; set; }

    private PasswordHasher<Data.Room> hasher = new PasswordHasher<Data.Room>();

    protected override void OnInitialized()
    {
        var state = auth.GetAuthenticationStateAsync().Result;
        if (state is not null)
        {
            var claims = userManager.GetUserAsync(state.User).Result;
            if (claims is not null)
            {
                User = DbContext.Users
                    .Include(u => u.Friendships)
                    .First(u => u.Id == claims.Id);

                MyRooms = DbContext.Rooms.Where(r => r.Owner.Id == User.Id).ToList();
                roomSearchResults = DbContext.Rooms.Where(r => !MyRooms.Select(mr=>mr.Id).Contains(r.Id)).Take(30).ToList();
            }
            else
            {
                roomSearchResults = DbContext.Rooms.Take(30).ToList();
                signInManager.SignOutAsync();
            }
        }

        base.OnInitialized();
    }

    private void GoToRoom(Data.Room room, string? password = null)
    {
        if (password is null)
        {
            Navigation.NavigateTo($"/Room/{room.Id}");
        }
        else
        {
            if (User == room.Owner)
            {
                Navigation.NavigateTo($"/Room/{room.Id}");
            }
            else if (hasher.VerifyHashedPassword(room, room.HashedPassword, password) == PasswordVerificationResult.Success)
            {
                sessionStorage.SetAsync("password_hash", room.HashedPassword);
                Navigation.NavigateTo($"/Room/{room.Id}");
            }
        }
    }

    private void SearchRooms()
    {
        if (roomSearch == string.Empty)
        {
            roomSearchResults = DbContext.Rooms.Take(30).ToList();
        }
        else
        {
            roomSearchResults = DbContext.Rooms.Where(r => r.Name.Contains(roomSearch)).ToList();
            
        }

		InvokeAsync(StateHasChanged);
	}

