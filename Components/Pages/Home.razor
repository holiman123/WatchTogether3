@page "/"
@rendermode InteractiveServer

@using System.Threading.Tasks
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WatchTogether3.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider auth
@inject UserManager<ApplicationUser> userManager
@inject SignInManager<ApplicationUser> signInManager
@inject ProtectedSessionStorage sessionStorage
@inject RoomsParticipantsService RoomsParticipants

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <br />
        <NavLink class="btn btn-primary" href="/CreateRoom">Create Room</NavLink>
        <br />
        <InputCheckbox @bind-Value="FriendsOnly" />Friends rooms
        <hr />

    </Authorized>
</AuthorizeView>

<InputText @bind-Value="roomSearch" @oninput="(e) => { roomSearch = e.Value.ToString(); SearchRooms(); }"/>

@foreach (Data.Room room in roomSearchResults)
{
    if (!FriendsOnly || (User is not null && User.Friendships
                                .Where(f => f.Status == FriendshipStatus.Accepted)
                                .Select(f => f.Friend)
                                .Contains(room.Owner)))
    {
        <p>@room.Name</p>
        <p>by @room.Owner.UserName</p>
        <p>watching @(room.CurrentVideo?.FriendlyName ?? "nothing 8_8")</p>
        <img src="@($"http://localhost:5000/api/Videos/getframe/{room.Id}_{room.CurrentVideo.FileName}-{room.CurrentVideo.CurrentTime}")"
            height="150">
        @if (RoomsParticipants.TryGetValue(room.Id, out List<ApplicationUser> users))
        {
            <p>@(users.Count())</p>
        }
        else
        {
            <p>0</p>
        }
        @if (room.EnterRoomPrivacyLevel == PrivacyLevel.Password)
        {
            if (!PasswordInputs.ContainsKey(room.Id))
                PasswordInputs[room.Id] = "";
            <input @bind="PasswordInputs[room.Id]"/>
            <button @onclick="() => GoToRoom(room, PasswordInputs[room.Id])">Join Room</button>
        }
        else
        {
            <button @onclick="() => GoToRoom(room)">Join Room</button>
        }
        <hr />
    }
}

<script>
    
</script>

@code {

    private string roomSearch { get; set; } = string.Empty;

    private ICollection<Data.Room> roomSearchResults { get; set; }

    private Dictionary<int, string> PasswordInputs { get; set; } = new Dictionary<int, string>();

    private bool FriendsOnly { get; set; } = false;

    private ApplicationUser User { get; set; }

    private PasswordHasher<Data.Room> hasher = new PasswordHasher<Data.Room>();

    protected override void OnInitialized()
    {
        roomSearchResults = DbContext.Rooms.Take(30).ToList();

        var state = auth.GetAuthenticationStateAsync().Result;
        if (state is not null)
        {
            var claims = userManager.GetUserAsync(state.User).Result;
            if (claims is not null)
            {
                User = DbContext.Users
                    .Include(u => u.Friendships)
                    .First(u => u.Id == claims.Id);
            }
            else
            {
                signInManager.SignOutAsync();
            }
        }

        base.OnInitialized();
    }

    private void GoToRoom(Data.Room room, string? password = null)
    {
        if (password is null)
        {
            Navigation.NavigateTo($"/Room/{room.Id}");
        }
        else
        {
            if (User == room.Owner)
            {
                Navigation.NavigateTo($"/Room/{room.Id}");
            }
            else if (hasher.VerifyHashedPassword(room, room.HashedPassword, password) == PasswordVerificationResult.Success)
            {
                sessionStorage.SetAsync("password_hash", room.HashedPassword);
                Navigation.NavigateTo($"/Room/{room.Id}");
            }
        }
    }

    private void SearchRooms()
    {
        if (roomSearch == string.Empty)
        {
            roomSearchResults = DbContext.Rooms.Take(30).ToList();
        }
        else
        {
            roomSearchResults = DbContext.Rooms.Where(r => r.Name.Contains(roomSearch)).ToList();
        }

		InvokeAsync(StateHasChanged);
	}

