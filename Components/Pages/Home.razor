@page "/"
@rendermode InteractiveServer

@using System.Threading.Tasks
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WatchTogether3.Data

@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider auth
@inject UserManager<ApplicationUser> userManager

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <p>Create room:</p>
        <form>
            <label for="roomName">Room Name:</label>
            <input type="text" id="roomName" name="roomName" @bind="roomName" />
            <br />
            <button type="button" @onclick="CreateRoom">Create Room</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <NavLink href="Account/Login">Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

<br />
<InputCheckbox @bind-Value="FriendsOnly">Friends rooms</InputCheckbox>
<hr />
@foreach (Data.Room room in DbContext.Rooms)
{
    if (!FriendsOnly || User.Friendships.Where(f => f.Status == FriendshipStatus.Accepted).Select(f => f.Friend).Contains(room.Owner))
    {
        <p>@room.Name</p>
        <p>by @room.Owner.UserName</p>
        <p>watching @room.CurrentVideo</p>
        <button @onclick="() => GoToRoom(room.Id)">Join Room</button>
        <hr />
    }
}

<script>
    
</script>

@code {
    private bool FriendsOnly { get; set; } = false;

    private string roomName = string.Empty;

    private ApplicationUser User { get; set; }

    protected override void OnInitialized()
    {
        var state = auth.GetAuthenticationStateAsync().Result;
        User = DbContext.Users
            .Include(u => u.Friendships)
            .First(u => u.Id == userManager.GetUserAsync(state.User).Result.Id);

        base.OnInitialized();
    }

    private void CreateRoom()
    {
        if (roomName == string.Empty)
            return;

        if (User is null)
            return;

        Data.Room newRoom = new Data.Room 
        { 
            Name = roomName,
            Owner = User,
            CreationDate = DateTime.Now
        };

        if(DbContext.Rooms.Contains(newRoom))
            return;

        DbContext.Rooms.Add(newRoom);

        DbContext.SaveChanges();

        GoToRoom(newRoom.Id);
    }

    private void GoToRoom(int id)
    {
        Navigation.NavigateTo($"/Room/{id}");
    }
}