@page "/"
@rendermode InteractiveServer

@using System.Threading.Tasks
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WatchTogether3.Data

@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider auth
@inject UserManager<ApplicationUser> userManager

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <p>Create room:</p>
        <form>
            <label for="roomName">Room Name:</label>
            <input type="text" id="roomName" name="roomName" @bind="roomName" />
            <br />

            <div>
                <p>Join room privacy</p>
			    <InputCheckbox @bind-Value="EnterRoomSecLevel.Public"/>
                Public
                <br/>
                <InputCheckbox @bind-Value="EnterRoomSecLevel.Password"  />
                Password
                <br />
                <InputCheckbox @bind-Value="EnterRoomSecLevel.Friends"  />
                Friends
                <br />
                <InputCheckbox @bind-Value="EnterRoomSecLevel.List"  />
                List
                <br />
                <InputCheckbox @bind-Value="EnterRoomSecLevel.Owner"  />
                Owner
            </div>

            <div>
                <p>Control room privacy</p>
                <InputCheckbox @bind-Value="ControlRoomSecLevel.Public" />
                Public
                <br />
                <InputCheckbox @bind-Value="ControlRoomSecLevel.Password" />
                Password
                <br />
                <InputCheckbox @bind-Value="ControlRoomSecLevel.Friends" />
                Friends
                <br />
                <InputCheckbox @bind-Value="ControlRoomSecLevel.List" />
                List
                <br />
                <InputCheckbox @bind-Value="ControlRoomSecLevel.Owner" />
                Owner
            </div>

            <br />
            <button type="button" @onclick="CreateRoom">Create Room</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <NavLink href="Account/Login">Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

<br />
<InputCheckbox @bind-Value="FriendsOnly"/>Friends rooms
<hr />
@foreach (Data.Room room in DbContext.Rooms)
{
    if (!FriendsOnly || (User is not null && User.Friendships
                                .Where(f => f.Status == FriendshipStatus.Accepted)
                                .Select(f => f.Friend)
                                .Contains(room.Owner)))
    {
        <p>@room.Name</p>
        <p>by @room.Owner.UserName</p>
        <p>watching @room.CurrentVideo</p>
        <button @onclick="() => GoToRoom(room.Id)">Join Room</button>
        <hr />
    }
}

<script>
    
</script>

@code {
    private bool FriendsOnly { get; set; } = false;

    private string roomName = string.Empty;

    private ApplicationUser User { get; set; }

    private PrioritySecurityLevel EnterRoomSecLevel = new PrioritySecurityLevel();
    private PrioritySecurityLevel ControlRoomSecLevel = new PrioritySecurityLevel();

    protected override void OnInitialized()
    {
        var state = auth.GetAuthenticationStateAsync().Result;
        var claims = userManager.GetUserAsync(state.User).Result;
        if (claims is not null)
        {
            User = DbContext.Users
                .Include(u => u.Friendships)
                .First(u => u.Id == claims.Id);
        }
        base.OnInitialized();
    }

    private void CreateRoom()
    {
        if (roomName == string.Empty)
            return;

        if (User is null)
            return;

        Data.Room newRoom = new Data.Room 
        { 
			EnterRoomPrivacyLevel = EnterRoomSecLevel.ToPrivacyLevel(),
			ControlRoomPrivacyLevel = ControlRoomSecLevel.ToPrivacyLevel(),
            Name = roomName,
            Owner = User,
            CreationDate = DateTime.Now
        };

        if(DbContext.Rooms.Contains(newRoom))
            return;

        DbContext.Rooms.Add(newRoom);

        DbContext.SaveChanges();

        GoToRoom(newRoom.Id);
    }

    private void GoToRoom(int id)
    {
        Navigation.NavigateTo($"/Room/{id}");
    }

    class PrioritySecurityLevel
    {
        private bool _public;
        public bool Public 
        {
            get => _public;
            set 
            {
                _public = value;
                _password = false;
                _friends = false;
                _list = false;
                _owner = false;
            }
        }

        private bool _password;
        public bool Password 
        {
            get => _password;
            set 
            {
                _public = false;
                _password = value;
                _friends = false;
                _list = false;
                _owner = false;
            }
        }

        private bool _friends;
        public bool Friends 
        {
            get => _friends;
            set 
            {
                _public = false;
                _password = false;
                _friends = value;
                _list = false;
                _owner = false;
            }
        }

        private bool _list;
        public bool List 
        {
            get => _list;
            set 
            {
                _public = false;
                _password = false;
                _friends = false;
                _list = value;
                _owner = false;
            }
        }

        private bool _owner;
        public bool Owner 
        {
            get => _owner;
            set 
            {
                _public = false;
                _password = false;
                _friends = false;
                _list = false;
                _owner = value;
            }
        }

        public PrivacyLevel ToPrivacyLevel()
        {
            if (Public) return PrivacyLevel.Public;
            if (Password) return PrivacyLevel.Password;
            if (Friends) return PrivacyLevel.Friends;
            if (List) return PrivacyLevel.PrivateList;
			if (Owner) return PrivacyLevel.Owner;

			return PrivacyLevel.Public; // default
        }
    }

    //TODO: Rooms access control(using friends system)
    //TODO: Friends search
    //TODO: Room search
    //TODO: Saving videos without rooms (like simple video-hosting)
    //TODO: Make it pretty
}