@page "/Room/{roomId:int}"
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.AspNetCore.Http.Connections
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@using System.Security.Claims
@using System.Text.Json.Serialization
@using WatchTogether3.Data

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider authState
@inject UserManager<ApplicationUser> userManager
@inject RoomsParticipantsService RoomsParticipants

<PageTitle>Room @RoomData.Name</PageTitle>

<h1>@RoomData.Owner?.UserName 's room</h1>

<hr>

<InputFile id="fileUpload" OnChange="LoadFile" style="display:none" />

@foreach(VideoFile video in RoomData.UploadedVideos.OrderBy(v => v.Order))
{
    <button @onclick="() => ChangeVideo(video)">@video.FriendlyName</button>
    <textarea @bind="tempNewVideoName" />
    <button @onclick="() => RenameVideo(video, tempNewVideoName)">Rename</button>
    <button @onclick="() => RemoveVideo(video)">X</button>
    <button @onclick="() => MoveVideoUp(video)">↑</button>
    <button @onclick="() => MoveVideoDown(video)">↓</button>
    <br />
}
@if (progress is null)
{
    <label for="fileUpload">+</label>
}
else
{
    <label>Uploading: @progress.Value.ToString("0.00")%</label>
    <button @onclick="() => FileUploadCTS.Cancel()">X</button>
}

<br />
<br/>


<video width="320" height="240" id="video_comp"
        onpause="OnPauseClick()"
        onplay="OnProceedClick()"
        onseeked="OnSeekClick()"
        src="@RoomData.CurrentVideo?.Url"
        >
    @* @if (RoomData.CurrentVideo is not null)
    {
        <source src="@RoomData.CurrentVideo.Url" type="video/mp4">
    } *@
    Your browser does not support the video tag.
</video>
<button id="play_btn" style="visibility: hidden" onclick="requestInitVideo()">Play</button>

<hr>

@if (User is not null && User.Id == RoomData.Owner.Id)
{
    <button @onclick="RemoveRoom">Remove room</button>
}

@if (RoomsParticipants.ContainsKey(roomId))
{
    foreach (ApplicationUser participant in RoomsParticipants[roomId])
    {
        if (participant is not null)
        {
            <p>@participant.UserName</p>
        }
        else
        {
            <p>Guest</p>
        }
    }
}

<script>
    var UserActions = Object.freeze({
        PauseVideo: 0,
        ProceedVideo: 1,
        SeekVideo: 2
    });

    var video = document.getElementById("video_comp");
    var DoSendAction = true;

    video.addEventListener('loadedmetadata', () => {
        console.log('Video metadata loaded. Requesting video init');
        requestInitVideo();
    });

    function requestInitVideo()
    {
        if (dnh != null) {
            dnh.invokeMethodAsync('InitVideo');
            play_btn.style.visibility = "hidden";
        }
    }

    // DotNet reference holder
    var dnh = null;
    function setDotnetReference(dotnetRef) {
        console.log("received DNR");
        dnh = dotnetRef;
    }

    function clearVideo()
    {
        video.src = "";
        video.load();
    }

    async function initVideo(time, isPlay) {
        console.log("initVideo");
        console.log(time);

        DoSendAction = false;
        console.log(await seekVideo(video, time));

        if (isPlay) {
            var promise = video.play();

            if (promise !== undefined) {
                promise.then(_ => {
                    // Autoplay started!
                    console.log("autoplay");
                    video.setAttribute("controls", "");
                }).catch(error => {
                    // Autoplay was prevented.
                    // Show a "Play" button so that user can start playback.
                    console.log("no autoplay!");
                    play_btn.style.visibility = "visible";
                });
            }
        }
        else {
            video.setAttribute("controls", "");
        }

        DoSendAction = true;
    }


    function SendAction(action, ...args) {
        if (dnh == null || DoSendAction == false)
        {
            console.log(dnh);
            console.log(DoSendAction);
            return;
        }

        dnh.invokeMethodAsync('ReceiveAction', action, args);
        console.log("SendAction");
    }



    async function PauseVideo(time) {
        console.log("PauseVideo");
        DoSendAction = false;
        await video.pause();
        await seekVideo(video, time);
        DoSendAction = true;
    }
    function OnPauseClick() {
        SendAction(UserActions.PauseVideo, video.currentTime);
    }


    async function ProceedVideo() {
        console.log("ProceedVideo");
        DoSendAction = false;
        await video.play();
        DoSendAction = true;
    }
    function OnProceedClick() {
        SendAction(UserActions.ProceedVideo);
    }


    async function SeekVideo(time) {
        console.log("SeekVideo");
        DoSendAction = false;
        await seekVideo(video, time);
        DoSendAction = true;
    }
    function OnSeekClick() {
        console.log("videoEvent");
        console.log(video.currentTime);
        SendAction(UserActions.SeekVideo, video.currentTime);
    }


    function seekVideo(videoElement, timeInSeconds) {
        if (timeInSeconds > videoElement.duration)
            return false;
        return new Promise((resolve, reject) => {
            if (!(videoElement instanceof HTMLVideoElement)) {
                reject(new Error("Invalid video element."));
            }
            if (typeof timeInSeconds !== "number" || timeInSeconds < 0) {
                reject(new Error("Invalid seek time."));
            }
            if (videoElement.readyState < 1) {
                // Wait until metadata is loaded to know duration
                videoElement.addEventListener("loadedmetadata", () => {
                    if (timeInSeconds > videoElement.duration) {
                        reject(new Error("Seek time exceeds video duration."));
                    }
                    videoElement.currentTime = timeInSeconds;
                }, { once: true });
            } else {
                if (timeInSeconds > videoElement.duration) {
                    reject(new Error("Seek time exceeds video duration."));
                }
                videoElement.currentTime = timeInSeconds;
            }

            // Resolve when seeking is complete
            videoElement.addEventListener("seeked", () => {
                resolve(`Seeked to ${timeInSeconds} seconds`);
            }, { once: true });

            // Optional: handle seek errors
            videoElement.addEventListener("error", () => {
                reject(new Error("An error occurred while seeking."));
            }, { once: true });
        });
    }
</script>

