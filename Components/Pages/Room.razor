@page "/Room/{roomId:int}"
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.AspNetCore.Http.Connections
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@using System.Security.Claims
@using System.Text.Json.Serialization
@using WatchTogether3.Components.VideoComponent
@using WatchTogether3.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage


@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider authState
@inject UserManager<ApplicationUser> userManager
@inject RoomsGuestsService RoomsGuests
@inject ProtectedSessionStorage sessionStorage

<div class="body">
    <div class="top">
        <p>@RoomData.Name</p>
    </div>
    <div class="bottom">
        @if (roomViewState == RoomViewState.Loading)
        {
            <h1>Loading...</h1>
        }
        else if (roomViewState == RoomViewState.FullAccess)
        {
            #region FullAccessView
            <PageTitle>Room @RoomData.Name</PageTitle>

            
            <InputFile id="fileUpload" OnChange="LoadFile" style="display:none" />
            <div class="videos-list">
                @foreach (VideoFile video in RoomData.UploadedVideos.OrderBy(v => v.Order))
                {
                    <div class="video-block">
                        <div class="video-image" @onclick="() => ChangeVideo(video)">
                            @if (video.SourceType == VideoSourceType.Local)
                            {
                                <img class="image-blur" src="@($"api/Videos/getframe/{RoomData.Id}_{video.FileName}-{video.CurrentTime}")">
                                <div class="image-window">
                                    <img class="image" src="@($"api/Videos/getframe/{RoomData.Id}_{video.FileName}-{video.CurrentTime}")">
                                </div>
                            }
                            else
                            {
                                <img class="image-blur" src="@($"https://img.youtube.com/vi/{video.YouTubeId}/hqdefault.jpg")">
                                <div class="image-window">
                                    <img class="image" src="@($"https://img.youtube.com/vi/{video.YouTubeId}/hqdefault.jpg")">
                                </div>
                            }
                            <div class="img-shadow" />
                            <p class="video-name">@video.FriendlyName</p>
                        </div>

                        <div class="video-bottom">
                            <div class="arrow-container arrow-container-left" @onclick="() => MoveVideoUp(video)">
                                <svg width="23" height="23">
                                    <g id="Arrow / Arrow_Up_SM">
                                        <path id="Vector" d="M12 17V7M12 7L8 11M12 7L16 11" stroke="#AFAFAF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </g>
                                </svg>
                            </div>
                            <div class="arrow-container" @onclick="() => RemoveVideo(video)">
                                <p>X</p>
                            </div>
                            <div class="arrow-container arrow-container-right" @onclick="() => MoveVideoDown(video)">
                                <svg width="23" height="23">
                                    <g id="Arrow / Arrow_Up_SM">
                                        <path id="Vector" d="M12 17V7M12 7L8 11M12 7L16 11" stroke="#AFAFAF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </g>
                                </svg>
                            </div>
                        </div>
                    </div>
                }
                <div class="add-video-block">
                    <div class="add-video-block-part add-youtube">
                        <InputText  @bind-Value="tempYTurl" 
                                    title="URL of the youtube video" 
                                    placeholder="youtube URL"/>
                        <div class="button" @onclick="AddYouTubeVideo">ADD</div>
                    </div>
                    <div class="add-video-block-part">
                        @if (progress is null)
                        {
                            <label for="fileUpload">FILE</label>
                        }
                        else
                        {
                            <label @onclick="() => FileUploadCTS.Cancel()">@progress.Value.ToString("0.00")%</label>
                        }
                    </div>
                </div>
            </div>

            
            <div class="name-area">
                <div class="name">
                    <p>@RoomData?.CurrentVideo?.FriendlyName</p>
                    @if (isRenamingVideo)
                    {
                        <input @bind-value="tempNewVideoName" />
                    }
                </div>
                <button class="button" @onclick="() => {
                            if (isRenamingVideo)
                                RenameVideo(RoomData?.CurrentVideo, tempNewVideoName);
                            else
                                tempNewVideoName = RoomData?.CurrentVideo?.FriendlyName;

                            isRenamingVideo = !isRenamingVideo;
                }">Rename</button>
            </div>

            <div class="video-area">
                @if (RoomData?.CurrentVideo?.SourceType == VideoSourceType.Local)
                {
                    <VideoComponentFile @ref="videoTt"
                                        Video="@(RoomData.CurrentVideo)"
                                        DoShowControls="@CanControlVideo" />
                }
                else if (RoomData?.CurrentVideo?.SourceType == VideoSourceType.YouTube)
                {
	                <VideoComponentYT @ref="videoTt"
                                      Video="@(RoomData.CurrentVideo)"
                                      DoShowControls="@CanControlVideo"/>
                }
            </div>

            <hr>

            @if (User is not null && User.Id == RoomData?.Owner?.Id)
            {
                <button @onclick="RemoveRoom">Remove room</button>
            }

            @foreach (ApplicationUser participant in RoomData?.Participants)
            {
                <p>@participant.UserName</p>
            }
            @foreach (string guest in RoomsGuests.GetGuests(roomId))
            {
                <p>Guest: @guest</p>
            }
            #endregion 
        }
        else if (roomViewState == RoomViewState.NoAccess)
        {
	        <h1>RESTRICTED ACCESS YOU FOOL!</h1>
        }
    </div>
</div>

@code {
    //First time changing video, it is not set time correctly. This is because video is not fully loaded when correct time is applied

    private VideoComponent videoTt { get; set; }

    [Parameter]
    public int roomId { get; set; }

    private RoomViewState roomViewState { get; set; } = RoomViewState.Loading;

    private bool CanControlVideo { get; set; } = false;

    private double? progress { get; set; } = null;

    private HubConnection Hub { get; set; }

    private ApplicationUser? User { get; set; }

    private Data.Room RoomData { get; set; }

    private CancellationTokenSource FileUploadCTS { get; set; }

    private string tempNewVideoName { get; set; } = string.Empty;

    private bool isRenamingVideo { get; set; } = false;

    private string tempYTurl { get; set; } = string.Empty;

    private bool VideoSourceTypeChanged = false;


    protected override void OnInitialized()
    {
        var claims = authState.GetAuthenticationStateAsync().Result.User;

        User = userManager.GetUserAsync(claims).Result;

        // Load room data
        DbContext.ChangeTracker.Clear();
        if (DbContext.Rooms.Find(roomId) is Data.Room room)
        {
            DbContext.Entry(room.Owner).Collection(o => o.Friendships).Load();
            RoomData = room;
        }

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Access stuff
            if (User?.Id == RoomData?.Owner.Id)
            {
                roomViewState = RoomViewState.FullAccess;
            }
            else if (RoomData?.EnterRoomPrivacyLevel == PrivacyLevel.Public)
            {
                roomViewState = RoomViewState.FullAccess;
            }
            else if (RoomData?.EnterRoomPrivacyLevel == PrivacyLevel.Password)
            {
                string? password_hash = (await sessionStorage.GetAsync<string>("password_hash")).Value;

                if (password_hash == RoomData.HashedPassword)
                    roomViewState = RoomViewState.FullAccess;
                else
                    roomViewState = RoomViewState.NoAccess;
            }
            else if (RoomData?.EnterRoomPrivacyLevel == PrivacyLevel.Friends)
            {
                if (RoomData.Owner.Friendships.Select(fr => fr.Friend?.Id).Contains(User?.Id))
                    roomViewState = RoomViewState.FullAccess;
                else
                    roomViewState = RoomViewState.NoAccess;
            }

            // Video control stuff
            CanControlVideo =
                User?.Id == RoomData?.Owner.Id ||
                (RoomData?.ControlVideoPrivacyLevel == PrivacyLevel.Public) ||
                (RoomData?.ControlVideoPrivacyLevel == PrivacyLevel.Friends && (RoomData.Owner.Friendships.Select(fr => fr.Friend?.Id).Contains(User?.Id)));


            string hubUri = Navigation.ToAbsoluteUri("/videohub").AbsoluteUri;
            HubConnectionBuilder hubBuilder = new HubConnectionBuilder();
#if DEBUG
            hubBuilder.ConfigureLogging(opt => opt.SetMinimumLevel(LogLevel.Trace).AddConsole());
#endif

            // All this options for SSL certificate validation are needed because
            // in development environment we use self-signed certificates, and without them SignalR won't connect to hub
            Hub = hubBuilder.WithUrl(hubUri, (opts) => {
                opts.HttpMessageHandlerFactory = (message) =>
                {
                    if (message is HttpClientHandler clientHandler)
                        // always verify the SSL certificate
                        clientHandler.ServerCertificateCustomValidationCallback +=
                            (sender, certificate, chain, sslPolicyErrors) => { return true; };
                    return message;
                };
                opts.WebSocketConfiguration = wsc => wsc.RemoteCertificateValidationCallback = (sender, certificate, chain, policyErrors) => true;
            })
            .AddJsonProtocol(opt => opt.PayloadSerializerOptions.ReferenceHandler = ReferenceHandler.Preserve)
            .Build();

            Hub.On("UserJoinedFromHub", (string userId) =>
            {
                // DbContext.ChangeTracker.Clear();
                // RoomData = DbContext.Rooms.Find(RoomData.Id);
                // DbContext.Entry<Data.Room>(RoomData).Reload();
                InvokeAsync(StateHasChanged);
            });
            Hub.On("UserLeftFromHub", (string userId) =>
            {
                // DbContext.ChangeTracker.Clear();
                // RoomData = DbContext.Rooms.Find(RoomData.Id);
                // DbContext.Entry<Data.Room>(RoomData).Reload();
                InvokeAsync(StateHasChanged);
            });
            Hub.On("RoomRemovedFromHub", () =>
            {
                Navigation.NavigateTo("/");
            });
            Hub.On("ProceedFromHub", (double time) =>
            {
                videoTt.Seek(time);
                videoTt.Proceed();
            });
            Hub.On("PauseFromHub", (double time) =>
            {
                videoTt.Pause();
                videoTt.Seek(time);
            });
            Hub.On("RoomDataChangedFromHub", async (Data.Room roomData) =>
            {
                if (roomData.CurrentVideo?.SourceType != videoTt.Video?.SourceType)
                    VideoSourceTypeChanged = true;

                if (roomData.CurrentVideo is null)
                    videoTt.ClearSource();

                VideoFile? prevVideo = RoomData.CurrentVideo;
                VideoFile? newVideo = roomData.CurrentVideo;

                DbContext.ChangeTracker.Clear(); // Changing tracking instance to new one
                RoomData = roomData;
                DbContext.Rooms.Attach(RoomData);

                await InvokeAsync(StateHasChanged);
            });

            Hub.StartAsync().Wait();

            // Enter room
            if (User is not null)
            {
                DbContext.Users.Find(User.Id)?.CurrentRoom = RoomData;
                DbContext.SaveChanges();

                await Hub.SendAsync("EnterRoom", roomId, User.Id);
                await Hub.InvokeAsync("RoomDataChanged", roomId, RoomData);
            }
            else if (Hub.ConnectionId is not null)
            {
                RoomsGuests.AddRoomGuest(roomId, Hub.ConnectionId);
                Hub.InvokeAsync("EnterRoom", roomId, String.Empty).Wait();
            }

            await InvokeAsync(StateHasChanged);

            if (videoTt is not null && CanControlVideo)
            {
                videoTt.OnVideoProceed += SendVideoProceed;
                videoTt.OnVideoPause += SendVideoPause;
            }
        }

        if (VideoSourceTypeChanged)
        {
            if (videoTt is not null && CanControlVideo)
            {
                videoTt?.OnVideoProceed += SendVideoProceed;
                videoTt?.OnVideoPause += SendVideoPause;
            }

            VideoSourceTypeChanged = false;
        }
    }

    private void SendVideoProceed(VideoComponent videoComponent, double time)
    {
        if (Hub is null || RoomData.CurrentVideo is null || !CanControlVideo)
            return;

        Hub.SendAsync("Proceeded", roomId, time);

        RoomData.CurrentVideo.Play(time);
        DbContext.SaveChanges();
    }
    private void SendVideoPause(VideoComponent videoComponent, double time)
    {
        if (Hub is null || RoomData.CurrentVideo is null || !CanControlVideo)
            return;

        Hub.SendAsync("Paused", roomId, time);

        RoomData.CurrentVideo.Pause(time);
        DbContext.SaveChanges();
    }

    private async void LoadFile(InputFileChangeEventArgs e)
    {
        VideoFile videoFile = new VideoFile
        {
            Url = $"api/Videos/get/{roomId}_{e.File.Name}",
            FriendlyName = e.File.Name,
            FileName = e.File.Name,
            Path = Path.Combine("D:\\WatchTogether3_files\\", $"{roomId}_{e.File.Name}"),
            Room = RoomData,
            UploadDate = DateTime.Now
        };


        if (!File.Exists(videoFile.Path))
        {
            Stream uploadedFileStream = e.File.OpenReadStream(long.MaxValue);
            FileStream localFileStream = File.Create(videoFile.Path);
            FileUploadCTS = new CancellationTokenSource();

            Task.Run(async () =>
            {
                while (uploadedFileStream.Position < uploadedFileStream.Length && !FileUploadCTS.IsCancellationRequested)
                {
                    progress = (double)uploadedFileStream.Position / uploadedFileStream.Length * 100;
                    InvokeAsync(StateHasChanged);

                    await Task.Delay(100);
                }

                progress = null;
                InvokeAsync(StateHasChanged);
            });

            try
            {
                await uploadedFileStream.CopyToAsync(localFileStream, FileUploadCTS.Token);
            }
            catch (OperationCanceledException ex)
            {
                localFileStream.Dispose();
                uploadedFileStream.Dispose();

                File.Delete(videoFile.Path);
            }

            if (!FileUploadCTS.IsCancellationRequested)
            {
                localFileStream.Dispose();
                uploadedFileStream.Dispose();

                RoomData.CurrentVideo = videoFile;
                RoomData.UploadedVideos.Add(videoFile);
                DbContext.SaveChanges();

                //await hub.InvokeAsync("VideoUploaded", roomId, videoFile);
                await Hub.InvokeAsync("RoomDataChanged", roomId, RoomData);

                await Task.Delay(100);

            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void AddYouTubeVideo()
    {
        if (String.IsNullOrWhiteSpace(tempYTurl))
            return;

        VideoFile videoFile = new VideoFile
		{
			FriendlyName = tempYTurl,
			SourceType = VideoSourceType.YouTube,
			YouTubeUrl = tempYTurl,
			Room = RoomData,
			UploadDate = DateTime.Now
		};

        RoomData.CurrentVideo = videoFile;
        RoomData.UploadedVideos.Add(videoFile);
        DbContext.SaveChanges();

        Hub.InvokeAsync("RoomDataChanged", roomId, RoomData);
        tempYTurl = String.Empty;

        InvokeAsync(StateHasChanged);
    }

    private void MoveVideoUp(VideoFile video)
    {
        int index = RoomData.UploadedVideos.IndexOf(video);
        if (index != 0)
        {
            RoomData.UploadedVideos.ExchangeItems(index, index - 1);

            DbContext.SaveChanges();
            Hub.SendAsync("RoomDataChanged", roomId, RoomData);
        }
    }

    private void MoveVideoDown(VideoFile video)
    {
        int index = RoomData.UploadedVideos.IndexOf(video);
        if (index != RoomData.UploadedVideos.Count - 1)
        {
            RoomData.UploadedVideos.ExchangeItems(index, index + 1);

            DbContext.SaveChanges();
            Hub.SendAsync("RoomDataChanged", roomId, RoomData);
        }
    }

    private void ChangeVideo(VideoFile video)
    {
        if (video.SourceType != videoTt.Video?.SourceType)
            VideoSourceTypeChanged = true;

        RoomData.CurrentVideo?.Pause();
        RoomData.CurrentVideo = video;
        DbContext.SaveChanges();

        Hub.SendAsync("RoomDataChanged", roomId, RoomData);

        InvokeAsync(StateHasChanged);
    }

    private void RenameVideo(VideoFile video, string newName)
    {
        video.FriendlyName = newName;
        DbContext.SaveChanges();

        Hub.SendAsync("RoomDataChanged", roomId, RoomData);

        tempNewVideoName = video.FriendlyName;
    }

    private void RemoveVideo(VideoFile video)
    {
        if (video == RoomData.CurrentVideo)
        {
            this.videoTt.ClearSource();
        }

        DbContext.Videos.Remove(video);
        RoomData.UploadedVideos.Remove(video);

        Hub.SendAsync("RoomDataChanged", roomId, RoomData);

        if (DbContext.SaveChanges() != 0)
        {
            if (video.SourceType == VideoSourceType.Local)
            {
                Exception exception = null;
                Task.Run(async () =>
                {
                    for (int i = 0; i < 5; i++)
                    {
                        try {
                            File.Delete(video.Path);
                        } catch(Exception ex) { exception = ex; }
                        await Task.Delay(2000);
                    }
                }).ContinueWith((task) =>
                {
                    if (File.Exists(video.Path))
                        throw new Exception("Could not delete a file.", exception);
                });
            }
        }
    }

    private void RemoveRoom()
    {
        videoTt.ClearSource();

        foreach (VideoFile video in RoomData.UploadedVideos)
        {
            DbContext.Videos.Remove(video);
            if (File.Exists(video.Path))
            {
                File.Delete(video.Path);
            }
        }
        DbContext.SaveChanges();

        RoomData.UploadedVideos.Clear();

        DbContext.Rooms.Remove(RoomData);
        DbContext.SaveChanges();

        RoomsGuests.Remove(roomId);

        Hub.SendAsync("RoomRemoved", roomId);

        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        if (Hub is not null && Hub.ConnectionId is not null)
        {
            if (User is not null)
            {
                DbContext.Users.Find(User.Id).CurrentRoom = null;
                // User.CurrentRoom = null;
                DbContext.SaveChanges();

				Hub.SendAsync("LeaveRoom", roomId, User.Id);
                Hub.InvokeAsync("RoomDataChanged", roomId, RoomData);
            }
            else if (Hub.ConnectionId is not null)
            {
                RoomsGuests.RemoveRoomGuest(roomId, Hub.ConnectionId);

                Hub.SendAsync("LeaveRoom", roomId, String.Empty);
            }

            // Pause video if room becomes empty
            if ((RoomData.Participants.Count + RoomsGuests.GetRoomGuestCount(roomId)) == 0 &&
                RoomData?.CurrentVideo is not null)
            {
                SendVideoPause(videoTt, RoomData.CurrentVideo.CurrentTime);
            }
                

            Hub.StopAsync();
            Hub = null;
        }
    }

    public enum UserActions2
    {
        PauseVideo,
        ProceedVideo
    }

    public enum RoomViewState
    {
        Loading,
        FullAccess,
		NoAccess
    }
}