@page "/Room/{roomId:int}"
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.AspNetCore.Http.Connections
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@using System.Security.Claims
@using System.Text.Json.Serialization
@using WatchTogether3.Data

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider authState
@inject UserManager<ApplicationUser> userManager
@inject RoomsParticipantsService RoomsParticipants

<PageTitle>Room @RoomData.Name</PageTitle>

<h1>@RoomData.Owner?.UserName 's room</h1>

<hr>

<InputFile id="fileUpload" OnChange="LoadFile" style="display:none" />

@foreach(VideoFile video in RoomData.UploadedVideos)
{
    <button @onclick="() => ChangeVideo(video)">@video.FriendlyName</button>
    <textarea @bind="tempNewVideoName" />
    <button @onclick="() => RenameVideo(video, tempNewVideoName)">Rename</button>
    <button @onclick="() => RemoveVideo(video)">X</button>
    <br />
}
@if (progress is null)
{
    <label for="fileUpload">+</label>
}
else
{
    <label>Uploading: @progress.Value.ToString("0.00")%</label>
    <button @onclick="() => FileUploadCTS.Cancel()">X</button>
}

<br />
<br/>


<video width="320" height="240" id="video_comp"
        onpause="OnPauseClick()"
        onplay="OnProceedClick()"
        onseeked="OnSeekClick()"
        src="@RoomData.CurrentVideo?.Url">
    @* @if (RoomData.CurrentVideo is not null)
    {
        <source src="@RoomData.CurrentVideo.Url" type="video/mp4">
    } *@
    Your browser does not support the video tag.
</video>
<button id="play_btn" style="visibility: hidden" onclick="requestInitVideo()">Play</button>

<hr>

@if (User is not null && User.Id == RoomData.Owner.Id)
{
    <button @onclick="RemoveRoom">Remove room</button>
}

@if (RoomsParticipants.ContainsKey(roomId))
{
    foreach (ApplicationUser participant in RoomsParticipants[roomId])
    {
        if (participant is not null)
        {
            <p>@participant.UserName</p>
        }
        else
        {
            <p>Guest</p>
        }
    }
}

<script>
    var UserActions = Object.freeze({
        PauseVideo: 0,
        ProceedVideo: 1,
        SeekVideo: 2
    });

    var video = document.getElementById("video_comp");

    // DotNet reference holder
    var dnh = null;
    function setDotnetReference(dotnetRef) {
        dnh = dotnetRef;
    }

    function clearVideo()
    {
        video.src = "";
        video.load();
    }

    function initVideo(time, isPlay) {
        video.currentTime = time;
        if (isPlay) {
            var promise = video.play();

            if (promise !== undefined) {
                promise.then(_ => {
                    // Autoplay started!
                    video.setAttribute("controls", "");
                }).catch(error => {
                    // Autoplay was prevented.
                    // Show a "Play" button so that user can start playback.
                    play_btn.style.visibility = "visible";
                });
            }
        }
        else {
            video.setAttribute("controls", "");
        }
    }

    function requestInitVideo()
    {
        dnh.invokeMethodAsync('InitVideo');
        play_btn.style.visibility = "hidden";
    }


    function SendAction(action, ...args) {
        if (dnh == null)
            return;

        dnh.invokeMethodAsync('ReceiveAction', action, args);
    }



    function PauseVideo(time) {
        video.pause();
        video.currentTime = time;
    }
    function OnPauseClick() {
        SendAction(UserActions.PauseVideo, video.currentTime);
    }


    function ProceedVideo() {
        video.play();
    }
    function OnProceedClick() {
        SendAction(UserActions.ProceedVideo);
    }


    function SeekVideo(time) {
        video.currentTime = time;
    }
    function OnSeekClick() {
        SendAction(UserActions.SeekVideo, video.currentTime);
    }
</script>

@code {

    private double? progress;

    private HubConnection hub;

    private bool isActionReceivable = true;

    [Parameter]
    public int roomId { get; set; }

    private ApplicationUser? User { get; set; }

    private Data.Room RoomData { get; set; }

    private CancellationTokenSource FileUploadCTS { get; set; }

    private string tempNewVideoName { get; set; } = string.Empty;


    protected override void OnInitialized()
    {
        var claims = authState.GetAuthenticationStateAsync().Result.User;

        User = userManager.GetUserAsync(claims).Result;

        // Load room data
        DbContext.ChangeTracker.Clear();
        if (DbContext.Rooms.Find(roomId) is Data.Room room)
        {
            RoomData = room;
        }

        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            var lDotNetReference = DotNetObjectReference.Create(this);
            JS.InvokeVoidAsync("setDotnetReference", lDotNetReference);

            string hubUri = Navigation.ToAbsoluteUri("/videohub").AbsoluteUri;
            HubConnectionBuilder hubBuilder = new HubConnectionBuilder();
            #if DEBUG
            hubBuilder.ConfigureLogging(opt => opt.SetMinimumLevel(LogLevel.Trace).AddConsole());
            #endif
            hub = hubBuilder.WithUrl(hubUri)
            .AddJsonProtocol(opt => opt.PayloadSerializerOptions.ReferenceHandler = ReferenceHandler.Preserve)
            .Build();

            hub.On("UserJoinedFromHub", (string userId) =>
            {
                InvokeAsync(StateHasChanged);
            });
            hub.On("UserLeftFromHub", (string userId) =>
            {
                InvokeAsync(StateHasChanged);
            });
            hub.On("RoomRemovedFromHub", () =>
            {
                Navigation.NavigateTo("/");
            });
            hub.On("PauseFromHub", (double time) =>
            {
                isActionReceivable = false;
                JS.InvokeVoidAsync("PauseVideo", time);
            });
            hub.On("ProceedFromHub", () =>
            {
                isActionReceivable = false;
                JS.InvokeVoidAsync("ProceedVideo");
            });
            hub.On("SeekFromHub", (double time) =>
            {
                isActionReceivable = false;
                JS.InvokeVoidAsync("SeekVideo", time);
            });
            hub.On("RoomDataChangedFromHub", (Data.Room roomData) =>
            {
                if (roomData.CurrentVideo is null)
                    JS.InvokeVoidAsync("clearVideo");

                DbContext.ChangeTracker.Clear(); // Changing tracking instance to new one
                RoomData = roomData;
                DbContext.Rooms.Attach(RoomData);
                InvokeAsync(StateHasChanged);
            });
            // hub.On("VideoUploadedFromHub", (VideoFile video) =>
            // {
            //     RoomData.CurrentVideo = video;
            //     RoomData.UploadedVideos.Add(video);

            //     DbContext.ChangeTracker.Clear();
            //     InvokeAsync(StateHasChanged);
            // });
            // hub.On("VideoChangedFromHub", (VideoFile video) =>
            // {
            //     RoomData.CurrentVideo = video;

            //     DbContext.ChangeTracker.Clear();
            //     InvokeAsync(StateHasChanged);
            // });
            // hub.On("VideoRenamedFromHub", (VideoFile video) =>
            // {
            //     var localVideo = RoomData.UploadedVideos.FirstOrDefault(v => v.Id == video.Id);
            //     if (localVideo is not null)
            //     {
            //         localVideo.FriendlyName = video.FriendlyName;
            //     }
            //     DbContext.ChangeTracker.Clear();
            //     InvokeAsync(StateHasChanged);
            // });
            // hub.On("VideoRemovedFromHub", (VideoFile video) =>
            // {
            //     RoomData.UploadedVideos.Remove(video);

            //     if (video == RoomData.CurrentVideo)
            //     {
            //         RoomData.CurrentVideo = null;
            //         JS.InvokeVoidAsync("clearVideo");
            //     }

            //     DbContext.ChangeTracker.Clear();
            //     InvokeAsync(StateHasChanged);
            // });

            hub.StartAsync().Wait();

            // Enter room
            RoomsParticipants.AddRoomParticipant(roomId, User);

            if (User is not null)
                hub.InvokeAsync("EnterRoom", roomId, User.Id).Wait();
            else
                hub.InvokeAsync("EnterRoom", roomId, String.Empty).Wait();


            InitVideo();

            InvokeAsync(StateHasChanged);
        }

        base.OnAfterRender(firstRender);
    }

    [JSInvokable]
    public void ReceiveAction(UserActions2 actions, params JsonElement[] args)
    {
        if (isActionReceivable)
        {
            switch (actions)
            {
                case UserActions2.PauseVideo:
                    {
                        double time = args[0].GetDouble();
                        SendVideoPause(time);
                        break;
                    }
                case UserActions2.ProceedVideo:
                    {
                        SendVideoProceed();
                        break;
                    }
                case UserActions2.SeekVideo:
                    {
                        double time = args[0].GetDouble();
                        SendVideoSeek(time);
                        break;
                    }
            }
        }

        isActionReceivable = true;
    }

    [JSInvokable]
    public void InitVideo()
    {
        JS.InvokeVoidAsync("initVideo", RoomData.CurrentTime, RoomData.IsPlaying);
    }

    private void SendVideoPause(double time)
    {
        if (hub is null)
            return;

        hub.SendAsync("Paused", roomId, time);

        RoomData.CurrentTime = time;
        RoomData.IsPlaying = false;
        DbContext.SaveChanges();
    }
    private void SendVideoProceed()
    {
        if (hub is null)
            return;

        hub.SendAsync("Proceeded", roomId);

        RoomData.LastPlayTime = DateTime.Now;
        RoomData.IsPlaying = true;
        DbContext.SaveChanges();
    }
    private void SendVideoSeek(double time)
    {
        if (hub is null)
            return;

        hub.SendAsync("Seeked", roomId, time);

        if (RoomData.IsPlaying)
        {
            RoomData.LastPlayTime = DateTime.Now;
        }
        RoomData.CurrentTime = time;
        DbContext.SaveChanges();
    }

    private async void LoadFile(InputFileChangeEventArgs e)
    {
        VideoFile videoFile = new VideoFile
        {
            Url = $"api/Videos/get/{roomId}_{e.File.Name}",
            FriendlyName = e.File.Name,
            FileName = e.File.Name,
            Path = Path.Combine("D:\\WatchTogether3_files\\", $"{roomId}_{e.File.Name}"),
            Room = RoomData,
            UploadDate = DateTime.Now
        };


        if (!File.Exists(videoFile.Path))
        {
            Stream uploadedFileStream = e.File.OpenReadStream(long.MaxValue);
            FileStream localFileStream = File.Create(videoFile.Path);
            FileUploadCTS = new CancellationTokenSource();

            Task.Run(async () =>
            {
                while (uploadedFileStream.Position < uploadedFileStream.Length && !FileUploadCTS.IsCancellationRequested)
                {
                    progress = (double)uploadedFileStream.Position / uploadedFileStream.Length * 100;
                    InvokeAsync(StateHasChanged);

                    await Task.Delay(100);
                }

                progress = null;
                InvokeAsync(StateHasChanged);
            });

            try
            {
                await uploadedFileStream.CopyToAsync(localFileStream, FileUploadCTS.Token);
            }
            catch (OperationCanceledException ex)
            {
                localFileStream.Dispose();
                uploadedFileStream.Dispose();

                File.Delete(videoFile.Path);
            }

            if (!FileUploadCTS.IsCancellationRequested)
            {
                localFileStream.Dispose();
                uploadedFileStream.Dispose();

                RoomData.CurrentVideo = videoFile;
                RoomData.UploadedVideos.Add(videoFile);
                DbContext.SaveChanges();

                //await hub.InvokeAsync("VideoUploaded", roomId, videoFile);
                await hub.InvokeAsync("RoomDataChanged", roomId, RoomData);

                await Task.Delay(100);

            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ChangeVideo(VideoFile video)
    {
        RoomData.CurrentVideo = video;
        DbContext.SaveChanges();

        //hub.SendAsync("VideoChanged", roomId, RoomData.CurrentVideo);
        hub.SendAsync("RoomDataChanged", roomId, RoomData);
    }

    private void RenameVideo(VideoFile video, string newName)
    {
        video.FriendlyName = newName;
        DbContext.SaveChanges();

        //hub.SendAsync("VideoRenamed", roomId, video);
        hub.SendAsync("RoomDataChanged", roomId, RoomData);
    }

    private void RemoveVideo(VideoFile video)
    {
        try
        {
            if (video == RoomData.CurrentVideo)
            {
                //RoomData.CurrentVideo = null;
                JS.InvokeVoidAsync("clearVideo");
            }

            DbContext.Videos.Remove(video);
            RoomData.UploadedVideos.Remove(video);
            if (DbContext.SaveChanges() != 0)
            {
                File.Delete(video.Path);
                hub.SendAsync("RoomDataChanged", roomId, RoomData);
            }
        }
        catch(Exception ex)
        {
            _ = 0;
        }
    }

    private void RemoveRoom()
    {
        foreach (VideoFile video in RoomData.UploadedVideos)
        {
            DbContext.Videos.Remove(video);
            if (File.Exists(video.Path))
            {
                File.Delete(video.Path);
            }
        }
        DbContext.SaveChanges();

        RoomData.UploadedVideos.Clear();

        DbContext.Rooms.Remove(RoomData);
        DbContext.SaveChanges();

        RoomsParticipants.Remove(roomId);

        hub.SendAsync("RoomRemoved", roomId);

        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        if (hub is not null)
        {
            if (RoomsParticipants.TryGetValue(roomId, out List<ApplicationUser?> users))
            {
                users.Remove(User);

                if (users.Count == 0)
                    SendVideoPause(RoomData.CurrentTime);
            }

            if (User is not null)
                hub.SendAsync("LeaveRoom", roomId, User.Id);
            else
                hub.SendAsync("LeaveRoom", roomId, String.Empty);

            hub.StopAsync();
            hub = null;
        }
    }

    public enum UserActions2
    {
        PauseVideo,
        ProceedVideo,
        SeekVideo
    }
}